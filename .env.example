# Token opcional para aumentar a cota da API pública do GitHub.
# Nunca disponibilize esta variável em componentes cliente.
GITHUB_TOKEN=

# Ajustes operacionais opcionais. Os valores padrão do produto são 250 arquivos,
# 512 KB por arquivo e 5 MB no total.
TRACEBASE_MAX_ELIGIBLE_FILES=
TRACEBASE_MAX_FILE_BYTES=
TRACEBASE_MAX_TOTAL_BYTES=
